# Local development: create a Vercel AI Gateway key. On Vercel, OIDC can be used instead.
AI_GATEWAY_API_KEY=

# Optional separate Gateway keys with independent Vercel budgets per tier.
AI_GATEWAY_FAST_KEY=
AI_GATEWAY_CAPABLE_KEY=
AI_GATEWAY_FRONTIER_KEY=

# Dry-run returns a routing decision without calling a generation model.
ROUTER_DRY_RUN=true

# Internal and restricted data are denied by default. Enable only after provider and legal review.
ALLOW_INTERNAL_DATA=false
ALLOW_RESTRICTED_DATA=false

# Request-level Gateway privacy controls. Confirm provider support before relying on them.
AI_GATEWAY_ZERO_DATA_RETENTION=true
AI_GATEWAY_DISALLOW_PROMPT_TRAINING=true

# Optional comma-separated provider preference. Leave blank to use Gateway's uptime/latency routing.
AI_GATEWAY_PROVIDER_ORDER=

# Required before enabling production telemetry. Keep this secret and rotate through your secret store.
ROUTING_TELEMETRY_SALT=

# Required for forceModelAlias. Send it only as Authorization: Bearer <token>.
ROUTING_ADMIN_TOKEN=

# Optional bearer token protecting both API routes. Required for a non-public deployment.
ROUTER_API_TOKEN=

# Defensive request limits.
ROUTER_MAX_PROMPT_CHARS=30000
ROUTER_DEFAULT_MAX_OUTPUT_TOKENS=700
